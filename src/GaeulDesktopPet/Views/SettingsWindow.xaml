<Window x:Class="GaeulDesktopPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="miniGaeul 设置"
        Icon="/Assets/Icon/icon.png"
        Width="340" Height="430"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
  <ScrollViewer>
    <StackPanel Margin="16">
      <TextBlock Text="互动频率" FontWeight="SemiBold" Margin="0,4,0,6" />
      <UniformGrid Columns="5" Margin="0,0,0,2">
        <TextBlock Text="关闭" TextAlignment="Left" />
        <TextBlock Text="偶尔" TextAlignment="Center" />
        <TextBlock Text="经常" TextAlignment="Center" />
        <TextBlock Text="频繁" TextAlignment="Center" />
        <TextBlock Text="连续" TextAlignment="Right" />
      </UniformGrid>
      <Slider x:Name="FrequencySlider"
              Minimum="0" Maximum="4"
              TickFrequency="1"
              IsSnapToTickEnabled="True"
              TickPlacement="BottomRight"
              AutoToolTipPlacement="BottomRight"
              Margin="0,0,0,8" />

      <TextBlock Text="互动动作" FontWeight="SemiBold" Margin="0,12,0,4" />
      <ComboBox x:Name="InteractionComboBox"
                MinHeight="28"
                ToolTip="选择后角色会立即播放该互动动作" />
      <CheckBox x:Name="ContinuousActionBox"
                Content="连续动作"
                IsEnabled="False"
                Margin="0,8,0,4" />

      <TextBlock Text="显示大小" />
      <Slider x:Name="ScaleSlider"
              Minimum="0.75" Maximum="2.5"
              TickFrequency="0.05" IsSnapToTickEnabled="True" />
      <Button Content="恢复默认大小" Margin="0,8,0,12" Click="OnDefaultSize" />

      <CheckBox x:Name="StartupBox" Content="开机自动启动" Margin="0,4" />
      <CheckBox x:Name="FullscreenBox" Content="全屏应用运行时暂停置顶" Margin="0,4" />
      <CheckBox x:Name="HiddenBox" Content="隐藏桌宠" Margin="0,4,0,12" />

      <Button Content="重置位置" Click="OnResetPosition" Margin="0,4" />
      <Button Content="关于" Click="OnAbout" Margin="0,4" />
      <Button Content="退出程序" Click="OnExit" Margin="0,4" />
      <Button Content="关闭" Width="80" HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnClose" />
    </StackPanel>
  </ScrollViewer>
</Window>

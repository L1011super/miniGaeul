<Window x:Class="GaeulDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/Icon/icon.png"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="OnLeftButtonDown"
        PreviewMouseMove="OnMouseMove"
        PreviewMouseLeftButtonUp="OnLeftButtonUp"
        PreviewMouseRightButtonUp="OnRightButtonUp">
  <Grid Background="Transparent">
    <Image x:Name="SpriteImage"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="NearestNeighbor"
           SnapsToDevicePixels="True">
      <Image.RenderTransform>
        <TransformGroup>
          <RotateTransform x:Name="DragRotate" CenterX="160" CenterY="160" />
          <TranslateTransform x:Name="DragTranslate" />
        </TransformGroup>
      </Image.RenderTransform>
    </Image>
  </Grid>
</Window>

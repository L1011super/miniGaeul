{
  "version": "2.0.0",
  "tasks": [
    { "label": "restore", "type": "process", "command": "dotnet", "args": ["restore"], "problemMatcher": "$msCompile" },
    { "label": "build", "type": "process", "command": "dotnet", "args": ["build"], "dependsOn": "restore", "problemMatcher": "$msCompile" },
    { "label": "test", "type": "process", "command": "dotnet", "args": ["test", "tests/GaeulDesktopPet.Tests/GaeulDesktopPet.Tests.csproj"], "dependsOn": "build", "problemMatcher": "$msCompile" },
    { "label": "run", "type": "process", "command": "dotnet", "args": ["run", "--project", "src/GaeulDesktopPet/GaeulDesktopPet.csproj"], "dependsOn": "build", "problemMatcher": "$msCompile" },
    { "label": "publish", "type": "shell", "command": "powershell", "args": ["-ExecutionPolicy", "Bypass", "-File", "tools/publish.ps1"], "problemMatcher": "$msCompile" }
  ]
}
